<!-- 라즈베리파이처럼 메모리가 적은 기계용 설정.
     
     ClickHouse 의 기본값은 서버를 통째로 쓰는 것을 전제한다. 파이에서는 같은
     기계에 DB Studio 도 같이 도므로, 그대로 두면 둘 중 하나가 OOM 으로 죽는다.
     
     특히 mark_cache_size 의 기본값이 5GiB 다. 캐시 상한이라 처음부터 다 잡는
     것은 아니지만, 파이의 전체 메모리보다 큰 값을 상한으로 두는 것은 상한을
     두지 않은 것과 같다. -->
<clickhouse>
    <!-- 전체 메모리의 절반까지만 쓴다. 남은 절반을 OS·DB Studio 가 쓴다. -->
    <max_server_memory_usage_to_ram_ratio>0.5</max_server_memory_usage_to_ram_ratio>

    <mark_cache_size>268435456</mark_cache_size>          <!-- 256 MiB -->
    <uncompressed_cache_size>0</uncompressed_cache_size>  <!-- 끈다 -->

    <!-- 코어가 넷뿐이므로 뒷일 스레드를 줄인다. 기본값(16)으로 두면 병합이
         조회를 굶긴다. -->
    <background_pool_size>4</background_pool_size>
    <background_schedule_pool_size>4</background_schedule_pool_size>
    <max_concurrent_queries>8</max_concurrent_queries>

    <profiles>
        <default>
            <!-- 질의 하나가 쓸 수 있는 메모리. 넘으면 그 질의만 실패하고
                 서버는 산다 — 파이에서는 이 구분이 중요하다. -->
            <max_memory_usage>1000000000</max_memory_usage>  <!-- 약 1 GB -->
            <max_threads>4</max_threads>
        </default>
    </profiles>
</clickhouse>
