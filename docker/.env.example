# docker/compose.yaml 이 읽는 값들.
#
#   cp docker/.env.example docker/.env
#   # 그리고 아래 "반드시 채울 것" 두 줄을 채운다
#
# .env 는 커밋하지 않는다(.gitignore). 이 파일은 무엇을 채워야 하는지 알려 주는
# 견본이므로 **실제 값을 여기에 적지 않는다**.
#
# 셸에서 export 하지 않고 이 파일에 두는 이유: compose 는 up 뿐 아니라
# down·logs·config 에서도 값 치환을 먼저 한다. 셸에만 두면 새 터미널에서
# `down` 이 실패한다.

# ── 반드시 채울 것 ─────────────────────────────────────────────────────

# 자격증명 암호화 키. 등록한 DB 비밀번호가 이 키로 잠긴다.
#
#   openssl rand -base64 32
#
# 이 값을 잃으면 저장된 자격증명을 열 수 없다(데이터는 남지만 커넥션은 다시
# 등록해야 한다). 반대로 이 값이 새면 볼륨만 있으면 남이 열 수 있다 — 백업과
# 다른 곳에 두는 편이 낫다.
DBSTUDIO_MASTER_KEY=

# 함께 뜨는 MySQL 의 root 비밀번호.
#
# 기본값을 주지 않는다. rootpw123 같은 것이 기본으로 박혀 있으면 그대로 뜨는
# 배치가 반드시 생기고, 그것은 이 앱이 관리하려는 DB 자체가 열려 있다는 뜻이다.
MYSQL_ROOT_PASSWORD=

# ── MySQL ──────────────────────────────────────────────────────────────

# 처음 뜰 때 만들 데이터베이스 이름.
MYSQL_DATABASE=appdb

# 앱 계정을 함께 만들고 싶을 때만 채운다(root 로 붙는 것보다 낫다).
# 둘 다 채워야 만들어진다. root 는 여기에 적을 수 없다(이미 있는 계정이다).
# MYSQL_USER=appuser
# MYSQL_PASSWORD=

# ── 밖에서 접속하기 (ngrok) ─────────────────────────────────────────────
#
# 터널은 기본으로 뜨지 않는다. 켜려면:
#
#   docker compose -f docker/compose.yaml --profile tunnel up -d
#   docker compose -f docker/compose.yaml logs ngrok   # 주소가 여기 찍힌다
#
# 터널을 켠다는 것은 이 앱의 로그인 화면이 인터넷에 열린다는 뜻이다. 켜기 전에
# 첫 계정의 임시 비밀번호를 바꾸고 2단계 인증을 켜 두는 편이 낫다.
NGROK_AUTHTOKEN=

# 예약해 둔 도메인이 있을 때만(무료 계정도 하나는 받는다). 비워 두면 뜰 때마다
# 주소가 바뀐다. 쓰려면 compose.yaml 의 ngrok command 주석도 함께 바꾼다.
# NGROK_DOMAIN=example-1234.ngrok-free.app

# ── 프록시·터널 뒤에 둘 때 ──────────────────────────────────────────────
#
# ngrok 이나 리버스 프록시(Caddy·Traefik·nginx)를 앞에 두면 둘 다 true 로 둔다.
#
#   SECURE_COOKIE: HTTPS 로 서비스하므로 세션 쿠키에 Secure 를 붙인다.
#   TRUST_PROXY:   X-Forwarded-For 를 클라이언트 IP 로 쓴다. 이것을 켜지 않으면
#                  감사 로그의 IP 가 전부 프록시 주소로 통일되어 "누가 어디서
#                  했는가"가 사라진다.
#
# 신뢰할 프록시 대역은 비워 두면 루프백과 사설 대역이 기본이라, 같은 compose
# 네트워크 안의 ngrok 컨테이너는 그대로 들어온다(따로 적을 것이 없다).
DBSTUDIO_SECURE_COOKIE=false
DBSTUDIO_TRUST_PROXY=false
